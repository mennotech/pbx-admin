# Copy this file to deploy/fly.toml and replace the app name and region.

app = 'your-pbx-admin-app'
primary_region = 'yyz'

[build]
  dockerfile = 'deploy/Containerfile'

[env]
  CONTROL_PREFIX = '/-control'
  DB_AUTO_SEED = 'false'
  PORT = '8080'
  SESSION_TTL_HOURS = '12'
  SQLITE_PATH = '/data/pbx_admin.db'
  UPSTREAM_TIMEOUT_SECONDS = '45'
  UPSTREAM_VERIFY_TLS = 'false'

[processes]
  app = '/app/start.sh'

[[mounts]]
  source = 'pbx_admin_data'
  destination = '/data'
  processes = ['app']

[checks]
  [checks.health]
    port = 8080
    type = 'http'
    interval = '30s'
    timeout = '5s'
    grace_period = '20s'
    method = 'get'
    path = '/-control/healthz'
    protocol = 'http'

[[vm]]
  memory = '512mb'
  cpu_kind = 'shared'
  cpus = 1
  memory_mb = 512
